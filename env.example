# Copy to .env next to the compose file and fill in. Never commit the real .env.

# --- Navidrome ---------------------------------------------------------------
NAVIDROME_URL=http://host.docker.internal:4533
NAVIDROME_USER=
NAVIDROME_PASS=

# Playlist that receives every download.
NAVIDROME_PLAYLIST=songkey


# --- MeTube ------------------------------------------------------------------
METUBE_URL=http://host.docker.internal:8081
METUBE_QUALITY=best
METUBE_FORMAT=mp3
# Subfolder inside MeTube's download directory. Empty means the root.
METUBE_FOLDER=

# --- Service -----------------------------------------------------------------
LISTEN_ADDR=:8090

# Ceiling on how many entries are read from a playlist link. Anything beyond
# this is ignored and reported in the reply.
PLAYLIST_MAX_ITEMS=100

# Full ntfy topic URL for phone notifications. Leave empty to disable them.
#
# Anyone who knows the topic name can read the notifications, so use a long
# random one rather than something guessable like "music".
#   NTFY_URL=https://ntfy.sh/<long-random-topic>
NTFY_URL=

# Shared secret required by every endpoint. Leave empty only on a network you
# fully trust; set it if the service is reachable through the Cloudflare tunnel.
API_TOKEN=

# How often the worker checks for finished downloads. It does nothing at all
# when no download is pending.
WORKER_INTERVAL=60

# How often the playlist is compared with the whole library, adding any song it
# is missing. This catches songs the worker could not recognise or that were
# added by hand. Accepts seconds (3600) or a duration (1h). 0 disables it, for
# anyone who removes songs from the playlist on purpose.
RECONCILE_INTERVAL=1h

# --- Maintenance scripts (tools/*.py only; the service ignores these) --------
# SSH access to the server and where the files live there.
#   SONGKEY_SSH_HOST=192.0.2.10
#   SONGKEY_SSH_USER=
#   SONGKEY_SSH_KEY=~/.ssh/id_ed25519
#   SONGKEY_MUSIC_DIR=/srv/music
#   SONGKEY_APPDATA_DIR=/srv/appdata
