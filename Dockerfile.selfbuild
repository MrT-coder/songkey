# Self-contained build, for a machine that can afford to compile.
#
# The default Dockerfile expects a pre-built binary instead, which is the right
# choice for the target server. Use this one only when building elsewhere:
#   docker build -f Dockerfile.selfbuild -t songkey:latest .

FROM golang:1.22-alpine AS build

WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/songkey ./cmd/server

FROM debian:bookworm-slim

ARG YTDLP_VERSION=2025.01.26

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL -o /usr/local/bin/yt-dlp \
        "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/yt-dlp_linux" \
    && chmod +x /usr/local/bin/yt-dlp \
    && apt-get purge -y curl \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/songkey /usr/local/bin/songkey

VOLUME ["/data"]
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/songkey"]
